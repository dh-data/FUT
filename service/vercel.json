{
    "version": 2,
    "builds": [
        {
            "src": "dist/main.js",
            "use": "@now/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/dist/main.js"
        }
    ],
    "buildCommand": "npm run build",
    "installCommand": "npm install"
}